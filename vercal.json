  async function protectHtmlFast(htmlCode) {
    const encoder = new TextEncoder();
    const bytes = encoder.encode(htmlCode);

    const cs = new CompressionStream('deflate');
    const writer = cs.writable.getWriter();
    writer.write(bytes);
    writer.close();
    const compressedBuffer = await new Response(cs.readable).arrayBuffer();
    const compressedBytes = new Uint8Array(compressedBuffer);

    let binary = '';
    for (let i = 0; i < compressedBytes.length; i++) {
      binary += String.fromCharCode(compressedBytes[i]);
    }
    const encoded = btoa(binary);

    const protectedHtml =
      '<!DOCTYPE html>\n' +
      '<html>\n' +
      '<head>\n' +
      '<meta charset="UTF-8">\n' +
      '<meta name="viewport" content="width=device-width, initial-scale=1.0">\n' +
      '<title>Protected by Dgtl Protect</title>\n' +
      '</head>\n' +
      '<body>\n' +
      '<script>\n' +
      '(function(){\n' +
      'const data = "' + encoded + '";\n' +
      'async function decode(){\n' +
      '    const binary = atob(data);\n' +
      '    const bytes = new Uint8Array(binary.length);\n' +
      '    for(let i = 0; i < binary.length; i++) {\n' +
      '        bytes[i] = binary.charCodeAt(i);\n' +
      '    }\n' +
      '    const stream = new DecompressionStream("deflate");\n' +
      '    const writer = stream.writable.getWriter();\n' +
      '    writer.write(bytes);\n' +
      '    writer.close();\n' +
      '    const buffer = await new Response(stream.readable).arrayBuffer();\n' +
      '    return new TextDecoder().decode(buffer);\n' +
      '}\n' +
      'decode().then(html => {\n' +
      '    document.open();\n' +
      '    document.write(html);\n' +
      '    document.close();\n' +
      '});\n' +
      '})();\n' +
      '<\/script>\n' +
      '</body>\n' +
      '</html>\n';

    return protectedHtml;
  }

  protectBtn.addEventListener('click', async function() {
    const html = protectInput.value.trim();
    
    if (!html) {
      showProtectStatus('⚠️ Please paste some HTML code first!', 'error');
      return;
    }

    if (html.length < 20) {
      showProtectStatus('⚠️ HTML code seems too short.', 'error');
      return;
    }

    protectBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Protecting...';
    protectBtn.disabled = true;

    try {
      const protectedHTML = await protectHtmlFast(html);
      
      const blob = new Blob([protectedHTML], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'protected.html';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      
      showProtectStatus('✅ HTML Protected & Downloaded!', 'success');
      showNotification('🛡️ HTML Protected!', 'Your file has been downloaded as protected.html');
      
    } catch (e) {
      console.error('Protect error:', e);
      showProtectStatus('❌ Error: ' + e.message, 'error');
    }
    
    protectBtn.innerHTML = '<i class="fas fa-shield-alt"></i> Protect';
    protectBtn.disabled = false;
  });

