<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5, user-scalable=yes" />
  <title>Dgtl Store</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  
  <!-- Firebase SDKs -->
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
  <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    :root {
      --bg: #f0f2f5;
      --bg2: #ffffff;
      --bg3: #e8ebf0;
      --bg4: #eef1f5;
      --bg5: #e2e6ed;
      --border: #d0d5dd;
      --border2: #c8cdd6;
      --text: #1a1d23;
      --text2: #1e2229;
      --text3: #4a4f5a;
      --text4: #6b7280;
      --card-bg: #ffffff;
      --card-border: #dce1e9;
      --icon-bg: #eef1f5;
      --icon-border: #d0d5dd;
      --badge-bg: #dce1e9;
      --search-bg: #ffffff;
      --meta-bg: #ffffff;
      --meta-border: #dce1e9;
      --nav-color: #5a5f6a;
      --nav-active: #e69500;
      --rating-bg: #eef1f5;
      --rating-border: #d0d5dd;
      --shadow: rgba(0,0,0,0.1);
      --sep: #d0d5dd;
      --input-bg: #ffffff;
      --input-border: #d0d5dd;
      --sarkari-color: #e65100;
      --top-job-border: #e69500;
      --top-job-bg: rgba(230, 149, 0, 0.08);
      --lock-color: #e69500;
      --unlock-color: #28a745;
      --highlight-bg: rgba(230, 149, 0, 0.12);
      --highlight-border: rgba(230, 149, 0, 0.35);
      --highlight-text: #e69500;
      --highlight-glow: rgba(230, 149, 0, 0.15);
    }

    body.dark {
      --bg: #0b0d10;
      --bg2: #121418;
      --bg3: #1b1e26;
      --bg4: #1e2128;
      --bg5: #171b22;
      --border: #2e323b;
      --border2: #282d36;
      --text: #eee;
      --text2: #e6ecf5;
      --text3: #b0b8c5;
      --text4: #404652;
      --card-bg: #1b1e26;
      --card-border: #282d36;
      --icon-bg: #262b34;
      --icon-border: #3b414d;
      --badge-bg: #2a2d35;
      --search-bg: #1e2128;
      --meta-bg: #171b22;
      --meta-border: #2b303a;
      --nav-color: #7b8392;
      --nav-active: #f5c842;
      --rating-bg: #1f232b;
      --rating-border: #2f3540;
      --shadow: rgba(0,0,0,0.7);
      --sep: #323844;
      --input-bg: #1a1e26;
      --input-border: #2e323b;
      --sarkari-color: #ff6b35;
      --top-job-border: #f5c842;
      --top-job-bg: rgba(245, 200, 66, 0.08);
      --lock-color: #f5c842;
      --unlock-color: #34c759;
      --highlight-bg: rgba(245, 200, 66, 0.15);
      --highlight-border: rgba(245, 200, 66, 0.4);
      --highlight-text: #f5c842;
      --highlight-glow: rgba(245, 200, 66, 0.2);
    }

    body {
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      transition: background 0.3s, color 0.3s;
      margin: 0;
      padding: 0;
    }

    .app-wrapper {
      max-width: 480px;
      width: 100%;
      background: var(--bg2);
      box-shadow: 0 0 30px var(--shadow);
      padding: 16px 14px 110px;
      min-height: 100vh;
      transition: background 0.3s;
      position: relative;
    }

    @media (min-width: 768px) {
      .app-wrapper {
        max-width: 100%;
        padding: 20px 30px 110px;
      }
      .app-grid {
        grid-template-columns: repeat(4, 1fr);
      }
      .books-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .app-grid {
        grid-template-columns: repeat(5, 1fr);
      }
      .books-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      padding: 4px 0;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .brand img {
      height: 45px;
      width: 45px;
      border-radius: 10px;
      object-fit: cover;
    }
    .brand h1 {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: -0.3px;
      background: linear-gradient(135deg, #f5c842, #ff9f1c);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .notif-btn {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text3);
      width: 38px;
      height: 38px;
      border-radius: 50%;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.3s, border 0.3s, color 0.3s;
      flex-shrink: 0;
      position: relative;
    }
    .notif-btn:hover {
      background: var(--border);
    }
    .notif-btn .badge-dot {
      position: absolute;
      top: 2px;
      right: 2px;
      width: 10px;
      height: 10px;
      background: #ff3b30;
      border-radius: 50%;
      border: 2px solid var(--bg2);
      transition: border 0.3s;
    }

    .header-avatar-btn {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      overflow: hidden;
      cursor: pointer;
      border: 2px solid var(--border);
      transition: border 0.3s, transform 0.2s;
      flex-shrink: 0;
      background: var(--bg3);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0;
    }
    .header-avatar-btn:hover {
      transform: scale(1.05);
      border-color: var(--nav-active);
    }
    .header-avatar-btn img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .header-avatar-btn .default-avatar-icon {
      font-size: 18px;
      color: var(--text3);
    }

    .notif-popup {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%) translateY(-100px);
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px 20px;
      box-shadow: 0 8px 30px var(--shadow);
      z-index: 999;
      max-width: 420px;
      width: 92%;
      text-align: center;
      transition: transform 0.4s ease, opacity 0.4s ease;
      opacity: 0;
      pointer-events: none;
      max-height: 92vh;
      overflow-y: auto;
    }
    .notif-popup.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
      pointer-events: auto;
    }
    .notif-popup::-webkit-scrollbar {
      width: 4px;
    }
    .notif-popup::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }
    .notif-popup .notif-icon {
      font-size: 32px;
      color: var(--nav-active);
      margin-bottom: 8px;
    }
    .notif-popup .notif-title {
      font-size: 18px;
      font-weight: 600;
      color: var(--text2);
      margin-bottom: 4px;
    }
    .notif-popup .notif-msg {
      font-size: 14px;
      color: var(--text3);
      margin-bottom: 12px;
    }
    .notif-popup .notif-close {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text);
      padding: 6px 20px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 13px;
      transition: background 0.3s;
      margin-top: 12px;
    }
    .notif-popup .notif-close:hover {
      background: var(--border);
    }

    .notif-tabs {
      display: flex;
      gap: 6px;
      margin: 14px 0 0;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0;
      justify-content: center;
    }
    .notif-tab {
      background: transparent;
      border: none;
      color: var(--text3);
      padding: 8px 14px;
      cursor: pointer;
      font-size: 12px;
      font-weight: 600;
      transition: all 0.3s;
      border-bottom: 2px solid transparent;
      margin-bottom: -1px;
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .notif-tab.active {
      color: #00ff00;
      border-bottom-color: #00ff00;
    }
    .notif-tab:hover {
      color: var(--text2);
    }
    .notif-tab i {
      font-size: 13px;
    }

    .protect-section {
      display: none;
      padding-top: 14px;
    }
    .protect-section.active {
      display: block;
    }
    .notif-protect-header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .notif-protect-header .protect-mini-icon {
      font-size: 20px;
    }
    .notif-protect-header h3 {
      font-size: 14px;
      font-weight: 700;
      color: var(--text2);
      background: linear-gradient(135deg, #00ff00, #00ffff);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: 1px;
    }
    .notif-protect-sub {
      font-size: 10px;
      color: var(--text3);
      margin-bottom: 10px;
      letter-spacing: 0.5px;
    }
    .protect-textarea-mini {
      width: 100%;
      min-height: 110px;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      border-radius: 10px;
      color: #00ff00;
      font-family: 'Courier New', monospace;
      font-size: 11px;
      padding: 10px;
      resize: vertical;
      transition: border 0.3s;
      line-height: 1.4;
      outline: none;
      box-sizing: border-box;
    }
    .protect-textarea-mini:focus {
      border-color: #00ff00;
      box-shadow: 0 0 15px rgba(0, 255, 0, 0.1);
    }
    .protect-textarea-mini::placeholder {
      color: var(--text4);
    }
    .protect-stats-mini {
      display: flex;
      justify-content: space-between;
      padding: 6px 2px;
      color: var(--text4);
      font-size: 10px;
      font-family: 'Courier New', monospace;
    }
    .protect-stats-mini .count {
      color: #00ff00;
    }
    .protect-btns-mini {
      display: flex;
      gap: 6px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .protect-btn-mini {
      flex: 1;
      min-width: 70px;
      padding: 9px 10px;
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 10px;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      text-transform: uppercase;
    }
    .protect-btn-primary-mini {
      background: linear-gradient(135deg, #00ff00, #00cc00);
      color: #000;
    }
    .protect-btn-primary-mini:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(0, 255, 0, 0.3);
    }
    .protect-btn-secondary-mini {
      background: var(--bg3);
      color: var(--text2);
      border: 1px solid var(--border);
    }
    .protect-btn-secondary-mini:hover {
      background: var(--border);
    }
    .protect-btn-python {
      background: linear-gradient(135deg, #3776ab, #ffd43b);
      color: #fff;
    }
    .protect-btn-python:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(55, 118, 171, 0.4);
    }
    .python-header h3 {
      background: linear-gradient(135deg, #3776ab, #ffd43b) !important;
      -webkit-background-clip: text !important;
      -webkit-text-fill-color: transparent !important;
      background-clip: text !important;
    }
    #pyProtectInput {
      color: #ffd43b;
    }
    #pyProtectInput:focus {
      border-color: #3776ab;
      box-shadow: 0 0 15px rgba(55, 118, 171, 0.2);
    }
    .protect-status-mini {
      margin-top: 8px;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 10px;
      font-weight: 600;
      display: none;
      text-align: center;
      word-break: break-word;
    }
    .protect-status-mini.show {
      display: block;
      animation: fadeIn 0.3s ease;
    }
    .protect-status-mini.success {
      background: rgba(0, 255, 0, 0.1);
      border: 1px solid rgba(0, 255, 0, 0.3);
      color: #00ff00;
    }
    .protect-status-mini.error {
      background: rgba(255, 0, 0, 0.1);
      border: 1px solid rgba(255, 0, 0, 0.3);
      color: #ff4444;
    }
    .protect-status-mini.info {
      background: rgba(0, 200, 255, 0.1);
      border: 1px solid rgba(0, 200, 255, 0.3);
      color: #00ccff;
    }

    .search-bar {
      background: var(--search-bg);
      border-radius: 30px;
      padding: 10px 18px;
      margin: 14px 0 18px;
      display: flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--border);
      transition: background 0.3s, border 0.3s;
    }
    .search-bar i {
      color: var(--text4);
      font-size: 16px;
    }
    .search-bar input {
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 15px;
      width: 100%;
      outline: none;
    }
    .search-bar input::placeholder {
      color: var(--text4);
    }

    .section-title {
      font-size: 18px;
      font-weight: 600;
      margin: 18px 0 12px 4px;
      color: var(--text2);
      transition: color 0.3s;
    }

    .app-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px 8px;
      margin-bottom: 10px;
    }
    .app-card {
      background: var(--card-bg);
      border-radius: 18px;
      padding: 12px 6px 12px;
      text-align: center;
      border: 1px solid var(--card-border);
      box-shadow: 0 2px 6px var(--shadow);
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: background 0.3s, border 0.3s, box-shadow 0.3s;
      position: relative;
      cursor: pointer;
      text-decoration: none;
      color: inherit;
    }
    .app-card .icon-wrap {
      width: 58px;
      height: 58px;
      border-radius: 16px;
      overflow: hidden;
      background: var(--icon-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 6px;
      border: 1px solid var(--icon-border);
      transition: background 0.3s, border 0.3s;
      position: relative;
    }
    .app-card .icon-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .app-card .app-name {
      font-size: 11px;
      font-weight: 500;
      color: var(--text2);
      line-height: 1.3;
      margin: 4px 0 2px;
      word-break: break-word;
      max-width: 100%;
      padding: 0 2px;
      transition: color 0.3s;
    }
    .app-card .rating {
      font-size: 11px;
      font-weight: 600;
      color: #f5b342;
      background: var(--rating-bg);
      padding: 2px 10px;
      border-radius: 30px;
      display: inline-block;
      margin-top: 2px;
      border: 1px solid var(--rating-border);
      transition: background 0.3s, border 0.3s;
    }
    .app-card .lock-badge {
      font-size: 10px;
      font-weight: 600;
      color: var(--lock-color);
      background: rgba(245, 200, 66, 0.15);
      padding: 2px 12px;
      border-radius: 12px;
      margin-top: 4px;
      border: 1px solid rgba(245, 200, 66, 0.3);
      display: inline-block;
    }
    .app-card .unlock-badge {
      font-size: 10px;
      font-weight: 600;
      color: var(--unlock-color);
      background: rgba(52, 199, 89, 0.15);
      padding: 2px 12px;
      border-radius: 12px;
      margin-top: 4px;
      border: 1px solid rgba(52, 199, 89, 0.3);
      display: inline-block;
    }
    .app-card .free-badge {
      font-size: 10px;
      font-weight: 600;
      color: var(--text3);
      background: var(--bg3);
      padding: 2px 12px;
      border-radius: 12px;
      margin-top: 4px;
      border: 1px solid var(--border);
      display: inline-block;
    }

    .app-card .admin-actions {
      position: absolute;
      top: 4px;
      right: 4px;
      display: none;
      gap: 4px;
    }
    .app-card .admin-actions.show {
      display: flex;
    }
    .app-card .admin-actions button {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text3);
      width: 24px;
      height: 24px;
      border-radius: 50%;
      font-size: 10px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.3s, border 0.3s, color 0.3s;
      z-index: 2;
    }
    .app-card .admin-actions button:hover {
      background: var(--border);
    }
    .app-card .admin-actions .delete-btn:hover {
      color: #ff3b30;
      border-color: #ff3b30;
    }
    .app-card .admin-actions .edit-btn:hover {
      color: #f5c842;
      border-color: #f5c842;
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100%;
      max-width: 480px;
      display: flex;
      justify-content: space-around;
      align-items: center;
      padding: 10px 4px 8px;
      background: var(--bg2);
      border-top: 1px solid var(--border);
      transition: background 0.3s, border 0.3s;
      z-index: 500;
    }
    @media (min-width: 768px) {
      .bottom-nav {
        max-width: 100%;
        padding: 10px 40px;
      }
    }
    @media (min-width: 1024px) {
      .bottom-nav {
        padding: 10px 60px;
      }
    }

    .nav-item {
      color: var(--nav-color);
      font-size: 12px;
      font-weight: 500;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      transition: color 0.3s;
      cursor: pointer;
      padding: 4px 10px;
      border-radius: 22px;
      text-decoration: none;
      background: transparent;
      border: none;
      flex: 1;
      max-width: 90px;
    }
    .nav-item i {
      font-size: 20px;
      transition: color 0.3s;
    }
    .nav-item.active {
      color: #1a73e8;
    }
    .nav-item.active i {
      color: #1a73e8;
    }
    .nav-item.active .nav-pill {
      background: #c9e7ff;
    }
    body.dark .nav-item.active {
      color: #f5c842;
    }
    body.dark .nav-item.active i {
      color: #f5c842;
    }
    body.dark .nav-item.active .nav-pill {
      background: rgba(245, 200, 66, 0.15);
    }
    .nav-pill {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 6px 18px;
      border-radius: 22px;
      transition: background 0.3s;
      background: transparent;
    }

    .books-container {
      display: none;
      margin-bottom: 10px;
    }
    .books-container.active {
      display: block;
    }
    .books-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px 10px;
    }
    .book-card {
      background: var(--card-bg);
      border-radius: 18px;
      padding: 16px 8px 14px;
      text-align: center;
      border: 1px solid var(--card-border);
      box-shadow: 0 2px 6px var(--shadow);
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: background 0.3s, border 0.3s, box-shadow 0.3s;
      text-decoration: none;
      color: var(--text2);
      cursor: pointer;
    }
    .book-card .book-icon {
      width: 60px;
      height: 60px;
      border-radius: 16px;
      background: var(--icon-bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin-bottom: 8px;
      border: 1px solid var(--icon-border);
      transition: background 0.3s, border 0.3s;
    }
    .book-card .book-icon.youtube { color: #ff0000; }
    .book-card .book-icon.telegram { color: #0088cc; }
    .book-card .book-icon.admin { color: var(--nav-active); }
    .book-card .book-icon.theme { color: var(--nav-active); }
    .book-card .book-name {
      font-size: 12px;
      font-weight: 500;
      color: var(--text2);
      transition: color 0.3s;
    }

    .game-card {
      background: var(--card-bg);
      border-radius: 18px;
      padding: 16px 8px 14px;
      text-align: center;
      border: 1px solid var(--card-border);
      box-shadow: 0 2px 6px var(--shadow);
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: background 0.3s, border 0.3s, box-shadow 0.3s;
      text-decoration: none;
      color: var(--text2);
      cursor: pointer;
    }
    .game-card .game-image {
      width: 80px;
      height: 80px;
      border-radius: 16px;
      overflow: hidden;
