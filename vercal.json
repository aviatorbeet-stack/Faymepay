  function renderApps(appsArray) {
    appGrid.innerHTML = '';
    if (!appsArray || appsArray.length === 0) {
      appGrid.innerHTML = `<p style="grid-column:span 3;text-align:center;color:var(--text3);padding:30px 0;">No apps found</p>`;
      return;
    }
    appsArray.forEach(app => {
      const card = document.createElement('div');
      card.className = 'app-card';
      card.dataset.id = app.id;
      
      const isLocked = app.locked === true;
      const isUnlocked = unlockedApps.includes(app.id);
      const price = app.price || 10;
      
      const clickHandler = (e) => {
        if (isAdmin) return;
        if (isLocked && !isUnlocked) {
          e.preventDefault();
          e.stopPropagation();
          openPayment(app.id, app.name, price);
        } else if (app.url && app.url !== '#') {
          window.open(app.url, '_blank');
        }
      };
      
      card.addEventListener('click', clickHandler);
      
      let badgeHtml = '';
      if (isLocked && !isUnlocked) {
        badgeHtml = `<span class="lock-badge"><i class="fas fa-lock"></i> ₹${price}</span>`;
      } else if (isLocked && isUnlocked) {
        badgeHtml = `<span class="unlock-badge"><i class="fas fa-unlock"></i> Unlocked</span>`;
      } else {
        badgeHtml = `<span class="free-badge"><i class="fas fa-check"></i> Free</span>`;
      }
      
      card.innerHTML = `
        <div class="icon-wrap">
          <img src="${app.image || 'https://via.placeholder.com/58'}" alt="${app.name}" loading="lazy" onerror="this.src='https://via.placeholder.com/58'">
        </div>
        <div class="app-name">${app.name}</div>
        <div class="rating">${app.rating || 'N/A'}</div>
        ${badgeHtml}
        <div class="admin-actions ${isAdmin ? 'show' : ''}">
          <button class="edit-btn" data-id="${app.id}"><i class="fas fa-pen"></i></button>
          <button class="delete-btn" data-id="${app.id}"><i class="fas fa-trash"></i></button>
        </div>
      `;
      appGrid.appendChild(card);
    });

    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        if (!isAdmin) return;
        const id = btn.dataset.id;
        const app = allApps.find(a => a.id === id);
        if (app) {
          editingAppId = id;
          editName.value = app.name || '';
          editRating.value = app.rating || '';
          editImage.value = app.image || '';
          editUrl.value = app.url || '';
          editLock.checked = app.locked === true;
          editPriceCost.value = app.price || 10;
          editOverlay.classList.add('show');
        }
      });
    });

    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        if (!isAdmin) return;
        const id = btn.dataset.id;
        if (confirm('Delete this app?')) {
          database.ref('apps/' + id).remove()
            .then(() => showNotification('🗑️ App deleted!', 'App has been removed!'))
            .catch(err => showNotification('❌ Error', 'Error: ' + err.message));
        }
      });
    });
  }

  function loadApps() {
    database.ref('apps').on('value', (snapshot) => {
      const data = snapshot.val();
      if (data) {
        allApps = Object.keys(data).map(key => ({ id: key, ...data[key] }));
      } else {
        allApps = [];
      }
      applySearchFilter();
    }, (error) => {
      console.error('Firebase load error:', error);
      showNotification('❌ Error', 'Error loading apps');
    });
  }

  function applySearchFilter() {
    const query = searchInput.value.toLowerCase().trim();
    let filtered = allApps;
    if (query) {
      filtered = allApps.filter(app => app.name.toLowerCase().includes(query));
    }
    renderApps(filtered);
  }

  searchInput.addEventListener('input', applySearchFilter);

  addAppBtn.addEventListener('click', () => {
    if (!isAdmin) return;
    const name = appNameInput.value.trim();
    const rating = appRatingInput.value.trim();
    const image = appImageInput.value.trim();
    const url = appUrlInput.value.trim();
    const locked = appLockInput.checked;
    const price = parseInt(appPriceInput.value) || 10;
    if (!name) {
      showNotification('❌ Error', 'App name is required');
      return;
    }
    const newApp = {
      name: name,
      rating: rating || 'N/A',
      image: image || 'https://via.placeholder.com/58',
      url: url || '#',
      locked: locked,
      price: price,
      timestamp: Date.now()
    };
    database.ref('apps').push(newApp)
      .then(() => {
        appNameInput.value = '';
        appRatingInput.value = '';
        appImageInput.value = '';
        appUrlInput.value = '';
        appLockInput.checked = false;
        appPriceInput.value = '10';
        showNotification('✅ App added!', `"${name}" has been added successfully!`, true);
        sendNotificationToAllUsers(name);
      })
      .catch(err => showNotification('❌ Error', 'Error: ' + err.message));
  });

  saveEditBtn.addEventListener('click', () => {
    if (!isAdmin || !editingAppId) return;
    const name = editName.value.trim();
    const rating = editRating.value.trim();
    const image = editImage.value.trim();
    const url = editUrl.value.trim();
    const locked = editLock.checked;
    const price = parseInt(editPriceCost.value) || 10;
    if (!name) {
      showNotification('❌ Error', 'App name is required');
      return;
    }
    const updates = {
      name: name,
      rating: rating || 'N/A',
      image: image || 'https://via.placeholder.com/58',
      url: url || '#',
      locked: locked,
      price: price,
      updatedAt: Date.now()
    };
    database.ref('apps/' + editingAppId).update(updates)
      .then(() => {
        editOverlay.classList.remove('show');
        editingAppId = null;
        showNotification('✅ App updated!', `"${name}" has been updated!`, true);
      })
      .catch(err => showNotification('❌ Error', 'Error: ' + err.message));
  });

  cancelEditBtn.addEventListener('click', () => {
    editOverlay.classList.remove('show');
    editingAppId = null;
  });

  editOverlay.addEventListener('click', (e) => {
    if (e.target === editOverlay) {
      editOverlay.classList.remove('show');
      editingAppId = null;
    }
  });

  loadAdminCredentials();
  loadApps();
  loadQRCode();

  booksContainer.classList.remove('active');
  gamesContainer.classList.remove('active');
  appGrid.style.display = 'grid';
  allAppsTitle.style.display = 'block';
  searchBarEl.style.display = 'flex';

  notifBadgeDot.style.display = 'none';
</script>

</body>
</html>