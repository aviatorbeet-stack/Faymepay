    // Reset UI
    document.getElementById('payInitialState').style.display = 'block';
    document.getElementById('qrLoadingState').style.display = 'block';
    document.getElementById('qrDisplayArea').style.display = 'none';
    document.getElementById('utrInput').value = '';
    document.getElementById('utrErrorMsg').style.display = 'none';
    
    paymentDetailOverlay.classList.add('show');
    
    // API Call to Generate QR with exact amount
    generatePaymentQR(price);
  }

  async function generatePaymentQR(amount) {
    try {
      const response = await fetch(`${FAM_API_URL}?amount=${amount}&api_key=${FAM_API_KEY}`);
      const data = await response.json();

      if (data.status === 'success' || data.status === true) {
        const upiLink = data.upi_link;
        
        // Show QR & Links
        document.getElementById('qrLoadingState').style.display = 'none';
        document.getElementById('qrDisplayArea').style.display = 'block';
        
        // Generate a proper scannable QR code
        document.getElementById('payQRCodeImage').src = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(upiLink)}`;
        
        // Set UPI App Links
        document.getElementById('btnGpay').href = upiLink;
        document.getElementById('btnPhonepe').href = upiLink;
        document.getElementById('btnPaytm').href = upiLink;
        
      } else {
        document.getElementById('qrLoadingState').innerHTML = '<p style="color:red;">Failed to generate payment link.</p>';
      }
    } catch (error) {
      console.error("API Error:", error);
      document.getElementById('qrLoadingState').innerHTML = '<p style="color:red;">Network Error. Try again.</p>';
    }
  }

  // ✅ UTR Verification Logic with Amount Check
  document.getElementById('verifyUtrBtn').addEventListener('click', async () => {
    const utr = document.getElementById('utrInput').value.trim();
    const errorMsg = document.getElementById('utrErrorMsg');
    const verifyBtn = document.getElementById('verifyUtrBtn');
    
    errorMsg.style.display = 'none';
    
    if (!utr || utr.length < 10) {
      errorMsg.textContent = '❌ Please enter a valid UTR / Transaction ID.';
      errorMsg.style.display = 'block';
      return;
    }

    verifyBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Verifying...';
    verifyBtn.disabled = true;

    try {
      // 1. Check if UTR already exists in Firebase
      const utrRef = database.ref('used_utrs/' + utr);
      
      let snapshot;
      try {
          snapshot = await utrRef.once('value');
      } catch (dbError) {
          console.error("Firebase Read Error:", dbError);
          throw new Error("Database Permission Denied.");
      }
      
      if (snapshot.exists()) {
        errorMsg.textContent = '❌ This UTR has already been used! Please enter a new one.';
        errorMsg.style.display = 'block';
        verifyBtn.innerHTML = 'Verify & Unlock App';
        verifyBtn.disabled = false;
        return;
      }

      // 2. If UTR is new, save it to Firebase with the exact amount
      try {
          await utrRef.set({
            usedAt: Date.now(),
            userId: userId,
            appId: currentPaymentItem,
            amount: currentPaymentAmount // ✅ Verify amount in database
          });
      } catch (dbError) {
          console.error("Firebase Write Error:", dbError);
          throw new Error("Database Write Failed.");
      }

      // 3. Unlock the app
      const unlocked = await unlockApp(currentPaymentItem);
      
      if (unlocked) {
          renderApps(allApps); // Re-render to show unlocked status
          showNotification('✅ Payment Verified!', 'App unlocked successfully!');
          paymentDetailOverlay.classList.remove('show');
          currentPaymentItem = null;
      } else {
          errorMsg.textContent = '❌ Failed to unlock app. Please try again.';
          errorMsg.style.display = 'block';
      }

    } catch (error) {
      console.error("UTR Verification Error:", error);
      errorMsg.textContent = '❌ Error: ' + error.message + '. Rules check karein.';
      errorMsg.style.display = 'block';
    } finally {
      verifyBtn.innerHTML = 'Verify & Unlock App';
      verifyBtn.disabled = false;
    }
  });

