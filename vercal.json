  function checkUserNotifications() {
    if (!userId) return;
    database.ref('users/' + userId + '/notifications').on('value', (snapshot) => {
      const data = snapshot.val();
      if (data) {
        const unread = Object.values(data).filter(n => n.read !== true);
        if (unread.length > 0) {
          notifBadgeDot.style.display = 'block';
          const latest = unread[unread.length - 1];
          if (latest) {
            showNotification(latest.title || '📢 New Update!', latest.message || 'New content added!', true);
            Object.keys(data).forEach(key => {
              if (data[key].read !== true) {
                database.ref('users/' + userId + '/notifications/' + key + '/read').set(true);
              }
            });
          }
        }
      }
    });
  }

