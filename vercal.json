  function applyAvatarToElement(el, avatar, fallbackInitial) {
    if (!el) return;
    if (avatar.type === 'image' && avatar.value) {
      el.innerHTML = '<img src="' + avatar.value + '" alt="avatar" onerror="this.style.display=\'none\';this.parentNode.innerHTML=\'' + (fallbackInitial || 'U') + '\';">';
    } else if (avatar.type === 'initial') {
      el.textContent = (avatar.value || fallbackInitial || 'U').charAt(0).toUpperCase();
    } else {
      el.textContent = (fallbackInitial || 'U').charAt(0).toUpperCase();
    }
    if (avatar.type === 'initial' && avatar.color) {
      el.style.background = avatar.color;
      el.style.color = '#fff';
    } else if (avatar.type === 'initial') {
      el.style.background = 'linear-gradient(135deg, #f5c842, #e6a800)';
      el.style.color = '#000';
    } else {
      el.style.background = 'linear-gradient(135deg, #f5c842, #e6a800)';
      el.style.color = '#000';
    }
  }

  function updateHeaderAvatar() {
