      const div = document.createElement('div');
      div.className = 'avatar-option';
      if (tempAvatar.type === 'image' && tempAvatar.value === url) {
        div.classList.add('selected');
      }
      div.innerHTML = '<img src="' + url + '" alt="av' + idx + '">';
      div.addEventListener('click', () => {
        tempAvatar = { type: 'image', value: url, color: null };
        selectedAvatarType = 'image';
        renderAvatarOptions();
        updateAvatarPreview();
      });
      avatarImageGrid.appendChild(div);
    });

    avatarColorGrid.innerHTML = '';
    AVATAR_COLORS.forEach((color) => {
      const div = document.createElement('div');
      div.className = 'avatar-color-option';
      div.style.background = color;
      if (tempAvatar.type === 'initial' && tempAvatar.color === color) {
        div.classList.add('selected');
      }
      div.addEventListener('click', () => {
        tempAvatar = { type: 'initial', value: userData.fullName || 'U', color: color };
        selectedAvatarType = 'initial';
        renderAvatarOptions();
        updateAvatarPreview();
