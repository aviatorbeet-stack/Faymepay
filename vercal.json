  function openPayment(appId, appName, price) {
    if (!userId) {
      openLogin();
      showNotification('🔒 Login Required', 'Please login to unlock apps!');
      return;
    }
    currentPaymentItem = appId;
    currentPaymentAmount = price; // ✅ Save the exact price to verify later
