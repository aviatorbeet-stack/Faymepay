  async function protectPythonFast(pythonCode) {
    try {
      const encoder = new TextEncoder();
      const bytes = encoder.encode(pythonCode);

      let compressedBytes;

      if (typeof CompressionStream !== 'undefined') {
        const cs = new CompressionStream('deflate');
        const writer = cs.writable.getWriter();
        writer.write(bytes);
        writer.close();
        const compressedBuffer = await new Response(cs.readable).arrayBuffer();
        compressedBytes = new Uint8Array(compressedBuffer);
      } else {
        compressedBytes = bytes;
      }

      let binary = '';
      for (let i = 0; i < compressedBytes.length; i++) {
        binary += String.fromCharCode(compressedBytes[i]);
      }
      const encoded = btoa(binary);

      const protectedCode =
        '#!/usr/bin/env python3\n' +
        '# -*- coding: utf-8 -*-\n' +
        'import base64\n' +
        'import zlib\n' +
        'import sys\n' +
        'import os\n' +
        '\n' +
        'def decode_and_execute():\n' +
        '    try:\n' +
        '        encoded = "' + encoded + '"\n' +
        '        decoded = base64.b64decode(encoded)\n' +
        '        decompressed = zlib.decompress(decoded)\n' +
        '        code = decompressed.decode("utf-8")\n' +
        '        exec(code, globals())\n' +
        '    except Exception as e:\n' +
        '        print(f"[!] Error: {e}")\n' +
        '        import traceback\n' +
        '        traceback.print_exc()\n' +
        '        sys.exit(1)\n' +
        '\n' +
        'if __name__ == "__main__":\n' +
        '    decode_and_execute()\n';

      return protectedCode;

    } catch (e) {
      console.warn('Compression failed:', e);
      const encoder = new TextEncoder();
      const bytes = encoder.encode(pythonCode);
      let binary = '';
      for (let i = 0; i < bytes.length; i++) {
        binary += String.fromCharCode(bytes[i]);
      }
      const encoded = btoa(binary);

      return '#!/usr/bin/env python3\n' +
        'import base64\n' +
        'import sys\n' +
        'try:\n' +
        '    exec(base64.b64decode("' + encoded + '").decode())\n' +
        'except Exception as e:\n' +
        '    print(f"Error: {e}")\n' +
        '    sys.exit(1)\n';
    }
  }

  pyProtectBtn.addEventListener('click', async function() {
    const pyCode = pyProtectInput.value.trim();
    
    if (!pyCode) {
      showPyProtectStatus('⚠️ Please paste some Python code first!', 'error');
      return;
    }

    if (pyCode.length < 10) {
      showPyProtectStatus('⚠️ Python code seems too short.', 'error');
      return;
    }

    pyProtectBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Protecting...';
    pyProtectBtn.disabled = true;

    try {
      const protectedPy = await protectPythonFast(pyCode);
      
      const blob = new Blob([protectedPy], { type: 'text/x-python' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'protected.py';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      
      showPyProtectStatus('✅ Python Protected & Downloaded!', 'success');
      showNotification('🐍 Python Protected!', 'Your file has been downloaded as protected.py');
      
    } catch (e) {
      console.error('Python protect error:', e);
      showPyProtectStatus('❌ Error: ' + e.message, 'error');
    }
    
    pyProtectBtn.innerHTML = '<i class="fab fa-python"></i> Protect';
    pyProtectBtn.disabled = false;
  });

