      overflow: hidden;
      cursor: pointer;
      border: 3px solid transparent;
      transition: all 0.3s;
      background: var(--bg3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      color: var(--text3);
    }
    .avatar-option:hover {
      transform: scale(1.1);
      border-color: var(--nav-active);
    }
    .avatar-option.selected {
      border-color: var(--nav-active);
      box-shadow: 0 0 0 3px rgba(245, 200, 66, 0.3);
    }
    .avatar-option img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .avatar-color-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
      margin-bottom: 10px;
    }
    .avatar-color-option {
      width: 100%;
      aspect-ratio: 1/1;
      border-radius: 50%;
      cursor: pointer;
      border: 3px solid transparent;
      transition: all 0.3s;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .avatar-color-option:hover {
      transform: scale(1.15);
    }
    .avatar-color-option.selected {
      border-color: var(--text);
      transform: scale(1.1);
    }
    .avatar-custom-preview {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      margin: 0 auto 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 44px;
      color: #fff;
      font-weight: 700;
      border: 4px solid var(--bg3);
      box-shadow: 0 4px 20px rgba(0,0,0,0.15);
      transition: all 0.3s;
      overflow: hidden;
      background: linear-gradient(135deg, #f5c842, #e6a800);
    }
    .avatar-custom-preview img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .avatar-action-btns {
      display: flex;
      gap: 8px;
      margin-top: 16px;
    }
    .avatar-action-btn {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .avatar-action-btn.save {
      background: linear-gradient(135deg, #34c759, #28a745);
      color: #fff;
    }
    .avatar-action-btn.save:hover {
      transform: scale(1.02);
      box-shadow: 0 4px 20px rgba(52, 199, 89, 0.3);
    }
    .avatar-action-btn.cancel {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text3);
    }
    .avatar-action-btn.cancel:hover {
      background: var(--border);
    }

    .admin-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.85);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1000;
      backdrop-filter: blur(8px);
      padding: 20px;
    }
    .admin-overlay.show {
      display: flex;
    }
    .admin-login-box {
      background: var(--bg2);
      border-radius: 24px;
      padding: 32px 28px;
      max-width: 400px;
      width: 100%;
      border: 1px solid var(--border);
      box-shadow: 0 20px 60px rgba(0,0,0,0.8);
      position: relative;
    }
    .admin-login-box .close-login {
      position: absolute;
      top: 12px;
      right: 16px;
      background: transparent;
      border: none;
      color: var(--text3);
      font-size: 22px;
      cursor: pointer;
      transition: color 0.3s;
    }
    .admin-login-box .close-login:hover {
      color: var(--text);
    }
    .admin-login-box h2 {
      font-size: 22px;
      font-weight: 700;
      color: var(--text2);
      margin-bottom: 4px;
      text-align: center;
    }
    .admin-login-box h2 i {
      color: var(--nav-active);
      margin-right: 8px;
    }
    .admin-login-box .sub {
      color: var(--text3);
      font-size: 14px;
      text-align: center;
      margin-bottom: 24px;
    }
    .admin-login-box label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      color: var(--text3);
      margin-bottom: 4px;
      margin-top: 14px;
    }
    .admin-login-box input {
      width: 100%;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--text);
      font-size: 15px;
      outline: none;
      transition: border 0.3s, background 0.3s, color 0.3s;
    }
    .admin-login-box input:focus {
      border-color: var(--nav-active);
    }
    .admin-login-box input::placeholder {
      color: var(--text4);
    }
    .admin-login-box .login-btn {
      width: 100%;
      padding: 14px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #f5c842, #e6a800);
      color: #000;
      font-size: 16px;
      font-weight: 700;
      margin-top: 22px;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .admin-login-box .login-btn:hover {
      transform: scale(1.02);
      box-shadow: 0 4px 20px rgba(245, 200, 66, 0.3);
    }
    .admin-login-box .login-btn:active {
      transform: scale(0.98);
    }
    .admin-login-box .cancel-btn {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: transparent;
      color: var(--text3);
      font-size: 15px;
      font-weight: 500;
      margin-top: 10px;
      cursor: pointer;
      transition: background 0.3s, border 0.3s, color 0.3s;
    }
    .admin-login-box .cancel-btn:hover {
      background: var(--bg3);
    }
    .admin-login-box .login-error {
      color: #ff3b30;
      font-size: 13px;
      text-align: center;
      margin-top: 10px;
      display: none;
    }
    .admin-login-box .login-error.show {
      display: block;
    }

    .admin-controls {
      display: none;
      background: var(--bg3);
      border-radius: 16px;
      padding: 16px;
      margin: 12px 0 16px;
      border: 1px solid var(--border);
    }
    .admin-controls.show {
      display: block;
    }
    .admin-controls .admin-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .admin-controls .admin-header h3 {
      font-size: 15px;
      color: var(--text2);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .admin-controls .admin-header h3 i {
      color: var(--nav-active);
    }
    .admin-controls .admin-header .logout-btn {
      background: var(--bg4);
      border: 1px solid var(--border);
      color: var(--text3);
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 12px;
      cursor: pointer;
      transition: background 0.3s, border 0.3s, color 0.3s;
    }
    .admin-controls .admin-header .logout-btn:hover {
      background: var(--border);
      color: var(--text);
    }

    .admin-controls .admin-tabs {
      display: flex;
      gap: 8px;
      margin-bottom: 12px;
      border-bottom: 1px solid var(--border);
      padding-bottom: 8px;
      flex-wrap: wrap;
    }
    .admin-controls .admin-tabs button {
      background: transparent;
      border: none;
      color: var(--text3);
      padding: 6px 16px;
      border-radius: 20px;
      cursor: pointer;
      font-size: 13px;
      font-weight: 500;
      transition: all 0.3s;
    }
    .admin-controls .admin-tabs button.active {
      background: var(--bg4);
      color: var(--text2);
      border: 1px solid var(--border);
    }
    .admin-controls .admin-tabs button:hover {
      color: var(--text);
    }

    .admin-controls .add-app-form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    .admin-controls .add-app-form input,
    .admin-controls .add-app-form select {
      padding: 8px 12px;
      border-radius: 10px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--text);
      font-size: 13px;
      outline: none;
      transition: border 0.3s, background 0.3s, color 0.3s;
    }
    .admin-controls .add-app-form input:focus,
    .admin-controls .add-app-form select:focus {
      border-color: var(--nav-active);
    }
    .admin-controls .add-app-form input::placeholder {
      color: var(--text4);
    }
    .admin-controls .add-app-form .add-btn {
      grid-column: span 2;
      padding: 10px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg, #34c759, #28a745);
      color: #fff;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .admin-controls .add-app-form .add-btn:hover {
      transform: scale(1.02);
    }
    .admin-controls .add-app-form .add-btn:active {
      transform: scale(0.98);
    }
    .admin-controls .add-app-form .url-full {
      grid-column: span 2;
    }
    .admin-controls .add-app-form .lock-check {
      grid-column: span 2;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
    }
    .admin-controls .add-app-form .lock-check input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: var(--nav-active);
    }
    .admin-controls .add-app-form .lock-check label {
      color: var(--text3);
      font-size: 13px;
      cursor: pointer;
    }

    .edit-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.8);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 1001;
      backdrop-filter: blur(6px);
      padding: 20px;
    }
    .edit-overlay.show {
      display: flex;
    }
    .edit-box {
      background: var(--bg2);
      border-radius: 24px;
      padding: 28px 24px;
      max-width: 380px;
      width: 100%;
      border: 1px solid var(--border);
      box-shadow: 0 20px 60px rgba(0,0,0,0.8);
    }
    .edit-box h3 {
      font-size: 18px;
      color: var(--text2);
      margin-bottom: 16px;
      text-align: center;
    }
    .edit-box h3 i {
      color: var(--nav-active);
      margin-right: 8px;
    }
    .edit-box label {
      display: block;
      font-size: 12px;
      font-weight: 500;
      color: var(--text3);
      margin-bottom: 3px;
      margin-top: 10px;
    }
    .edit-box input,
    .edit-box select {
      width: 100%;
      padding: 10px 12px;
      border-radius: 10px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--text);
      font-size: 14px;
      outline: none;
      transition: border 0.3s, background 0.3s, color 0.3s;
    }
    .edit-box input:focus,
    .edit-box select:focus {
      border-color: var(--nav-active);
    }
    .edit-box .edit-actions {
      display: flex;
      gap: 10px;
      margin-top: 18px;
    }
    .edit-box .edit-actions button {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 10px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s;
    }
    .edit-box .edit-actions .save-edit {
      background: linear-gradient(135deg, #f5c842, #e6a800);
      color: #000;
    }
    .edit-box .edit-actions .cancel-edit {
      background: var(--bg3);
      border: 1px solid var(--border);
      color: var(--text3);
    }
    .edit-box .edit-actions button:hover {
      transform: scale(1.02);
    }
    .edit-box .edit-actions button:active {
      transform: scale(0.98);
    }

    .admin-controls .add-app-form .price-cost {
      grid-column: span 2;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 4px 0;
    }
    .admin-controls .add-app-form .price-cost label {
      color: var(--text3);
      font-size: 13px;
      white-space: nowrap;
    }
    .admin-controls .add-app-form .price-cost input {
      flex: 1;
      min-width: 80px;
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--text);
      font-size: 13px;
      outline: none;
      width: 100px;
    }
    .admin-controls .add-app-form .price-cost input:focus {
      border-color: var(--nav-active);
    }

    .edit-box .price-cost-edit {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 8px;
    }
    .edit-box .price-cost-edit label {
      margin: 0;
      color: var(--text3);
      font-size: 13px;
    }
    .edit-box .price-cost-edit input {
      flex: 1;
      padding: 6px 10px;
      border-radius: 8px;
      border: 1px solid var(--input-border);
      background: var(--input-bg);
      color: var(--text);
      font-size: 13px;
      outline: none;
      width: 100px;
    }
    .edit-box .price-cost-edit input:focus {
      border-color: var(--nav-active);
    }

    @media (max-width: 420px) {
      .app-grid { gap: 8px 5px; }
      .app-card .icon-wrap { width: 50px; height: 50px; }
      .app-card .app-name { font-size: 10px; }
      .books-grid { gap: 10px 8px; }
      .book-card .book-icon { width: 50px; height: 50px; font-size: 22px; }
      .book-card .book-name { font-size: 11px; }
      .game-card .game-image { width: 70px; height: 70px; }
      .game-card .game-name { font-size: 12px; }
      .game-card .play-btn { padding: 5px 20px; font-size: 11px; }
      .admin-controls .add-app-form {
        grid-template-columns: 1fr;
      }
      .admin-controls .add-app-form .add-btn {
        grid-column: span 1;
      }
      .admin-controls .add-app-form .url-full {
        grid-column: span 1;
      }
      .admin-controls .add-app-form .lock-check {
        grid-column: span 1;
      }
      .admin-controls .add-app-form .price-cost {
        grid-column: span 1;
        flex-wrap: wrap;
      }
      .payment-detail-box {
        padding: 24px 20px;
      }
      .header-avatar-btn {
        width: 34px;
        height: 34px;
      }
      .notif-btn {
        width: 34px;
        height: 34px;
        font-size: 16px;
      }
      .brand img {
        height: 36px;
        width: 36px;
      }
      .brand h1 {
        font-size: 17px;
      }
      .user-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
      }
      .user-item .user-actions {
        width: 100%;
        justify-content: flex-start;
      }
      .nav-item {
        font-size: 11px;
        padding: 4px 6px;
      }
      .nav-item i {
        font-size: 18px;
      }
      .nav-pill {
        padding: 5px 14px;
      }
      .auth-box {
        padding: 24px 20px;
      }
      .auth-box .auth-header h2 {
        font-size: 20px;
      }
      .account-box {
        padding: 24px 20px;
      }
      .avatar-grid {
        grid-template-columns: repeat(3, 1fr);
      }
      .avatar-color-grid {
        grid-template-columns: repeat(5, 1fr);
      }
    }
    @media (min-width: 768px) {
      .app-wrapper {
        padding: 24px 40px 110px;
      }
      .header .brand h1 {
        font-size: 26px;
      }
    }
    @media (min-width: 1024px) {
      .app-wrapper {
        padding: 30px 60px 110px;
      }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>
<!-- ===== HIDDEN AUDIO ELEMENT FOR CLICK SOUND ===== -->
<audio id="clickSound" src="dgh134.mp3" preload="auto"></audio>

<div class="app-wrapper">

  <div class="header">
    <div class="brand">
      <img src="https://i.ibb.co/YFs4kJyb/google-play-store-apps-android-4gnews-og.jpg" alt="DGTL STORE" />
      <h1>DGTL STORE</h1>
    </div>
    <div class="header-right">
      <button class="notif-btn" id="notifBtn" title="Notifications">
        <i class="fas fa-bell"></i>
        <span class="badge-dot" id="notifBadgeDot"></span>
      </button>
      <button class="header-avatar-btn" id="myAccountBtn" title="My Account">
        <span class="default-avatar-icon" id="headerAvatarContent"><i class="fas fa-user"></i></span>
      </button>
    </div>
  </div>

  <div class="notif-popup" id="notifPopup">
    <div class="notif-icon"><i class="fas fa-bell"></i></div>
    <div class="notif-title" id="notifTitle">📢 New Update!</div>
    <div class="notif-msg" id="notifMsg">DGTL STORE me naye apps add hue hain. Check karo!</div>
    
    <div class="notif-tabs">
      <button class="notif-tab active" data-protect="html" id="htmlTabBtn">
        <i class="fas fa-code"></i> HTML
      </button>
      <button class="notif-tab" data-protect="python" id="pythonTabBtn">
        <i class="fab fa-python"></i> Python
      </button>
    </div>

    <div class="protect-section active" id="htmlProtectSection">
      <div class="notif-protect-header">
        <span class="protect-mini-icon">🛡️</span>
        <h3>HTML PROTECT</h3>
      </div>
      <div class="notif-protect-sub">✦ Paste • Protect • Download ✦</div>
      
      <textarea 
        id="protectInput" 
        class="protect-textarea-mini" 
        placeholder="Paste your HTML code here..."
        spellcheck="false"
      ></textarea>

      <div class="protect-stats-mini">
        <span>📊 <span id="protectCharCount" class="count">0</span> chars</span>
        <span>📏 <span id="protectLineCount" class="count">0</span> lines</span>
      </div>

      <div class="protect-btns-mini">
        <button class="protect-btn-mini protect-btn-primary-mini" id="protectBtn">
          <i class="fas fa-shield-alt"></i> Protect
        </button>
        <button class="protect-btn-mini protect-btn-secondary-mini" id="protectClearBtn">
          <i class="fas fa-eraser"></i> Clear
        </button>
        <button class="protect-btn-mini protect-btn-secondary-mini" id="protectExampleBtn">
          <i class="fas fa-file-code"></i> Example
        </button>
      </div>

      <div class="protect-status-mini" id="protectStatus"></div>
    </div>

    <div class="protect-section" id="pythonProtectSection">
      <div class="notif-protect-header python-header">
        <span class="protect-mini-icon">🐍</span>
        <h3>PYTHON PROTECT</h3>
      </div>
      <div class="notif-protect-sub">✦ Paste • Protect • Download .py ✦</div>
      
      <textarea 
        id="pyProtectInput" 
        class="protect-textarea-mini" 
        placeholder="Paste your Python code here..."
        spellcheck="false"
      ></textarea>

      <div class="protect-stats-mini">
        <span>📊 <span id="pyProtectCharCount" class="count">0</span> chars</span>
        <span>📏 <span id="pyProtectLineCount" class="count">0</span> lines</span>
      </div>

      <div class="protect-btns-mini">
        <button class="protect-btn-mini protect-btn-python" id="pyProtectBtn">
          <i class="fab fa-python"></i> Protect
        </button>
        <button class="protect-btn-mini protect-btn-secondary-mini" id="pyProtectClearBtn">
          <i class="fas fa-eraser"></i> Clear
        </button>
        <button class="protect-btn-mini protect-btn-secondary-mini" id="pyProtectExampleBtn">
          <i class="fas fa-file-code"></i> Example
        </button>
      </div>

      <div class="protect-status-mini" id="pyProtectStatus"></div>
    </div>
    
    <button class="notif-close" id="notifClose">Close</button>
  </div>

  <div class="auth-overlay" id="loginOverlay">
    <div class="auth-box">
      <button class="auth-close" id="closeLoginBtn2"><i class="fas fa-times"></i></button>
      <div class="auth-header">
        <div class="auth-icon"><i class="fas fa-sign-in-alt"></i></div>
        <h2>Welcome Back</h2>
        <p>Login to your account</p>
      </div>
      <button class="google-btn" id="googleLoginBtn">
        <i class="fab fa-google"></i> Continue with Google
      </button>
      <div class="divider">OR</div>
      <div class="auth-field">
        <label>Email</label>
        <input type="email" id="loginEmailField" placeholder="Enter your email">
      </div>
      <div class="auth-field">
        <label>Password</label>
        <input type="password" id="loginPasswordField" placeholder="Enter your password">
      </div>
      <div class="auth-error" id="loginErrorMsg">❌ Invalid email or password!</div>
      <button class="auth-submit" id="loginSubmitBtn"><i class="fas fa-sign-in-alt"></i> Login</button>
      <div class="forgot-password">
        <a id="forgotPasswordLink">Forgot Password?</a>
      </div>
      <div class="auth-switch">
        Don't have an account? <a id="goToSignup">Sign Up</a>
      </div>
    </div>
  </div>

  <div class="auth-overlay" id="signupOverlay">
    <div class="auth-box">
      <button class="auth-close" id="closeSignupBtn"><i class="fas fa-times"></i></button>
      <div class="auth-header">
        <div class="auth-icon"><i class="fas fa-user-plus"></i></div>
        <h2>Create Account</h2>
        <p>Sign up to get started</p>
      </div>
      <button class="google-btn" id="googleSignupBtn">
        <i class="fab fa-google"></i> Continue with Google
      </button>
      <div class="divider">OR</div>
      <div class="auth-field">
        <label>Full Name *</label>
        <input type="text" id="signupName" placeholder="Enter your full name">
      </div>
      <div class="auth-field">
        <label>Email *</label>
        <input type="email" id="signupEmail" placeholder="Enter your email">
      </div>
      <div class="auth-field">
        <label>Password *</label>
        <input type="password" id="signupPassword" placeholder="Create a password (min 6 chars)">
      </div>
