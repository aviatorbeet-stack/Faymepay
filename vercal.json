  auth.onAuthStateChanged((user) => {
    if (user) {
      userId = user.uid;
      userRegistered = true;
      console.log('✅ User logged in:', user.uid);
      
      if (userListener) {
        database.ref('users/' + userId).off('value', userListener);
      }
      
      userListener = database.ref('users/' + userId).on('value', (snapshot) => {
        const data = snapshot.val();
        if (data) {
          unlockedApps = data.unlocked || [];
          userData = data;
          if (!userData.fullName && user.displayName) userData.fullName = user.displayName;
          if (!userData.email && user.email) userData.email = user.email;
          
          if (data.avatar) {
            currentAvatar = data.avatar;
          } else {
            currentAvatar = { type: 'initial', value: userData.fullName || 'U', color: null };
          }
          updateHeaderAvatar();
          
          renderApps(allApps);
          checkUserNotifications();
        } else {
          const newData = {
            fullName: user.displayName || 'User',
            email: user.email || '',
            username: (user.email || '').split('@')[0],
            unlocked: [],
            registeredAt: Date.now(),
            avatar: { type: 'initial', value: user.displayName || 'U', color: null }
          };
          database.ref('users/' + userId).set(newData);
          userData = newData;
          currentAvatar = newData.avatar;
          unlockedApps = [];
          updateHeaderAvatar();
          renderApps(allApps);
        }
      });
    } else {
      userId = null;
      userRegistered = false;
      userData = {};
      unlockedApps = [];
      currentAvatar = { type: 'initial', value: 'U', color: null };
      if (userListener) {
        database.ref('users/' + userId).off('value', userListener);
        userListener = null;
      }
      updateHeaderAvatar();
      renderApps(allApps);
      console.log('👋 User logged out');
    }
  });

