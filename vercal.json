      clickSound.volume = 0;
      const p = clickSound.play();
      if (p !== undefined) {
        p.then(() => {
          clickSound.pause();
          clickSound.currentTime = 0;
          clickSound.volume = 0.5;
        }).catch(() => {});
      }
    }
    document.removeEventListener('touchstart', enableSoundOnce);
  }, { once: true });

