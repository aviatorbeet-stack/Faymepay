  function unlockApp(appId) {
    if (!userId) return Promise.resolve(false);
    return new Promise((resolve) => {
      database.ref('users/' + userId + '/unlocked').transaction((current) => {
        const arr = current || [];
        if (!arr.includes(appId)) {
          arr.push(appId);
        }
        return arr;
      }, (error, committed, snapshot) => {
        if (error) {
          resolve(false);
        } else if (committed) {
          unlockedApps = snapshot.val() || [];
          resolve(true);
        } else {
          resolve(false);
        }
      });
    });
  }

